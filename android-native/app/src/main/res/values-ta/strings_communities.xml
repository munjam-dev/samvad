    <!-- Phase 6: Communities. -->
    <string name="community_title">கம்யூனிட்டி</string>
    <string name="community_new">புதிய கம்யூனிட்டி</string>
    <string name="community_start">கம்யூனிட்டியைத் தொடங்கு</string>
