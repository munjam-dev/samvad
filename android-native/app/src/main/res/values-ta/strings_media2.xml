<resources>
    <!-- Phase 5: media on weak networks. Photo preview before sending. -->
    <string name="media2_preview_title">போட்டோ அனுப்பு</string>
    <string name="media2_preview_photo_cd">அனுப்ப வேண்டிய போட்டோ</string>
    <string name="media2_preview_send">அனுப்பு</string>
    <string name="media2_original_quality">அசல் தரம்</string>
    <string name="media2_original_quality_body">முழு அளவு போட்டோவை அனுப்பும். அதிக டேட்டா செலவாகும், மெதுவான இணைப்பில் நேரம் ஆகலாம். இருப்பிட விவரங்கள் எப்போதும் நீக்கப்படும்.</string>
    <string name="media2_photo_size">போட்டோ அளவு: %1$s</string>
    <string name="media2_photo_large_hint">இந்த போட்டோ 16 MB ஐ விடப் பெரியது, அதனால் பொருந்துவதற்காக சிறிதாக்கப்படலாம்.</string>
    <string name="media2_photo_reduced_quality">போட்டோ முழுத் தரத்தில் அனுப்ப மிகவும் பெரியதாக இருந்தது, அதனால் சற்று குறைந்த தரத்தில் அனுப்பப்பட்டது.</string>
    <string name="media2_photo_reduced_size">போட்டோ அசல் அளவில் அனுப்ப மிகவும் பெரியதாக இருந்தது, அதனால் சிறிதாக்கி அனுப்பப்பட்டது.</string>

