    <string name="settings_privacy">தனியுரிமை &amp; பாதுகாப்பு</string>
    <string name="settings_privacy_body">உங்கள் ஃபோன் எண் உங்களுக்கு மட்டுமே தெரியும். செய்திகள் பயணத்திலும் சேமிப்பிலும் Firebase மூலம் பாதுகாக்கப்படுகின்றன; Samvad இன்னும் எண்ட்-டு-எண்ட் என்கிரிப்ஷன் வழங்கவில்லை.</string>
    <string name="settings_help">உதவி &amp; கருத்து</string>
    <string name="settings_sign_out">வெளியேறு</string>
    <string name="settings_sign_out_all">அனைத்து சாதனங்களிலும் வெளியேறு</string>
    <string name="settings_sign_out_all_body">இதுவும் சேர்த்து அனைத்து அமர்வுகளையும் முடிக்கும். மற்ற சாதனங்களில் காலாவதியாக ஒரு மணி நேரம் வரை ஆகலாம்.</string>
    <string name="settings_signed_out_all">எல்லா இடங்களிலும் வெளியேறிவிட்டீர்கள்.</string>
    <string name="settings_delete">கணக்கை நீக்கு</string>
    <string name="settings_delete_body">இது உங்கள் சுயவிவரத்தை நிரந்தரமாக நீக்கி, எல்லா சாட்களிலிருந்தும் வெளியேற்றும். நீங்கள் அனுப்பிய செய்திகள் பெற்றவர்களிடமே இருக்கும். புதிய SMS குறியீட்டால் உறுதிசெய்வீர்கள்.</string>
    <string name="settings_delete_confirm">என் கணக்கை நீக்கு</string>
    <string name="settings_cooldown">ஒரு நிமிடம் காத்திருந்து மீண்டும் முயலவும்.</string>
