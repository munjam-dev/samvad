    <!-- Auth errors -->
    <string name="error_invalid_number">அந்த ஃபோன் எண் சரியானது அல்ல.</string>
    <string name="error_invalid_code">அந்தக் குறியீடு சரியில்லை. SMS-ஐப் பார்த்து மீண்டும் முயலவும்.</string>
    <string name="error_code_expired">இந்தக் குறியீடு காலாவதியாகிவிட்டது. புதியதைக் கோரவும்.</string>
    <string name="error_too_many">மிக அதிக முயற்சிகள். சிறிது நேரம் கழித்து மீண்டும் முயலவும்.</string>
    <string name="error_network">நீங்கள் ஆஃப்லைனில் உள்ளீர்கள். இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.</string>
    <string name="error_app_verification">இந்த ஆப்பைச் சரிபார்க்க முடியவில்லை. Samvad-ஐ புதுப்பித்து மீண்டும் முயலவும்.</string>
    <string name="error_user_disabled">இந்தக் கணக்கு முடக்கப்பட்டுள்ளது.</string>
    <string name="error_new_code_required">பல தவறான குறியீடுகள். புதிய குறியீட்டைக் கோரவும்.</string>
    <string name="error_unknown">ஏதோ தவறு நடந்தது. மீண்டும் முயலவும்.</string>
    <string name="error_hourly_limit">இந்த எண்ணுக்குப் பலமுறை குறியீடு கோரியுள்ளீர்கள். ஒரு மணி நேரம் கழித்து முயலவும்.</string>
    <string name="error_resend_limit">மீண்டும் அனுப்பும் வரம்பு முடிந்தது. பின்சென்று புதிய குறியீட்டைக் கோரவும்.</string>

