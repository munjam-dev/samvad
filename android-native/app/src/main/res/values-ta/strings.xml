    <string name="newchat_permission_body">நீங்கள் சாட் செய்யத் தொடங்க, உங்கள் தொடர்புகளின் ஃபோன் எண்களை Samvad கணக்குகளுடன் ஒப்பிட்டுப் பார்க்கிறோம். எண்கள் பாதுகாப்பாக அனுப்பப்பட்டு ஒப்பிடப்படும்; சேமிக்கப்படாது, யாருக்கும் காட்டப்படாது.</string>
    <string name="newchat_permission_allow">தொடர்புகளுக்கு அனுமதி</string>
    <string name="newchat_permission_denied">தொடர்புகள் அணுகல் முடக்கத்தில் உள்ளது. எண்ணைக் கொண்டு சாட் தொடங்கலாம்.</string>
    <string name="newchat_by_number">எண்ணைக் கொண்டு சாட் தொடங்கு</string>
    <string name="newchat_number_hint">நாட்டுக் குறியீட்டுடன் ஃபோன் எண்</string>
    <string name="newchat_search">தொடர்புகளைத் தேடு</string>
    <string name="newchat_on_samvad">Samvad-இல் உள்ளவர்கள்</string>
    <string name="newchat_none">உங்கள் தொடர்புகளில் யாரும் இன்னும் Samvad பயன்படுத்தவில்லை.</string>
    <string name="newchat_not_found">அந்த எண் இன்னும் Samvad-இல் இல்லை.</string>
    <string name="newchat_invite">அழை</string>
    <string name="newchat_invite_text">Samvad-இல் சாட் செய்யலாம் வாருங்கள் — அமைதியான, தனிப்பட்ட மெசஞ்சர்.</string>
    <string name="newchat_limit">இன்றைய தேடல் வரம்பு முடிந்தது. நாளை முயலவும்.</string>
    <string name="newchat_start">சாட்</string>

