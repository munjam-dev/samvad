    <string name="onboarding_get_started">தொடங்கு</string>
    <string name="onboarding_1_title">உங்கள் உரையாடல்கள், இணைந்து.</string>
    <string name="onboarding_1_body">உங்களுக்கு முக்கியமானவர்களுடன் பேசுங்கள் — வேகமாக, நிம்மதியாக, உங்கள் மொழியில்.</string>
    <string name="onboarding_2_title">தனியுரிமையுடன் தொடக்கமே</string>
    <string name="onboarding_2_body">உங்கள் ஃபோன் எண் தனிப்பட்டதாகவே இருக்கும். நீங்கள் சாட் செய்பவர்கள் மட்டுமே உங்கள் பெயரையும் அறிமுகத்தையும் பார்க்க முடியும்.</string>
    <string name="onboarding_3_title">தினமும் பயன்படுத்த ஏற்றது</string>
    <string name="onboarding_3_body">லைட், டார்க், ட்ரூ-பிளாக் தீம்கள், எந்த எழுத்து அளவிலும் படிக்க எளிது, பேட்டரிக்கும் டேட்டாவுக்கும் சிக்கனம்.</string>
    <string name="onboarding_page">பக்கம் %1$d / %2$d</string>

    <!-- Phone -->
    <string name="phone_title">உங்கள் ஃபோன் எண்</string>
    <string name="phone_body">நீங்கள்தான் என்பதை உறுதிசெய்ய 6 இலக்கக் குறியீட்டை SMS-இல் அனுப்புவோம். நெட்வொர்க் கட்டணம் பொருந்தலாம்.</string>
