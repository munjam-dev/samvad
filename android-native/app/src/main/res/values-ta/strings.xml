    <!-- Phase 1.3: block and report -->
    <string name="chat_block">பிளாக் செய்</string>
    <string name="chat_unblock">அன்பிளாக் செய்</string>
    <string name="chat_report">புகார் செய்</string>
    <string name="block_title">%1$s ஐ பிளாக் செய்யவா?</string>
    <string name="block_body">இந்த சாட்டில் இருவரும் செய்தி அனுப்ப முடியாது; மற்றவரின் ஆன்லைன் நிலையையும் கடைசியாகப் பார்த்ததையும் பார்க்க முடியாது. Samvad அவர்களுக்குத் தெரிவிக்காது.</string>
    <string name="blocked_banner">நீங்கள் %1$s ஐ பிளாக் செய்துள்ளீர்கள்.</string>
    <string name="report_title">%1$s ஐப் புகார் செய்</string>
    <string name="report_body">இந்தத் தொடர்பின் கடைசி 5 செய்திகள் மதிப்பாய்வுக்காக Samvad-க்கு அனுப்பப்படும். அவர்களுக்குத் தெரிவிக்கப்படாது.</string>
    <string name="report_reason_spam">ஸ்பாம் அல்லது மோசடி</string>
    <string name="report_reason_abuse">தவறான அல்லது வெறுப்புப் பேச்சு</string>
    <string name="report_reason_harassment">தொந்தரவு அல்லது மிரட்டல்</string>
    <string name="report_reason_impersonation">வேறொருவர் போல நடிக்கிறார்</string>
    <string name="report_reason_other">வேறு காரணம்</string>
    <string name="report_also_block">இந்தத் தொடர்பையும் பிளாக் செய்</string>
    <string name="report_sent">நன்றி. உங்கள் புகார் அனுப்பப்பட்டது.</string>
    <string name="report_sent_blocked">புகார் அனுப்பப்பட்டு, தொடர்பு பிளாக் செய்யப்பட்டது.</string>
    <string name="report_limit">இன்று பல புகார்கள் அனுப்பிவிட்டீர்கள். நாளை முயலவும்.</string>
    <string name="safety_failed">புதுப்பிக்க முடியவில்லை. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.</string>
    <string name="settings_blocked">பிளாக் செய்த தொடர்புகள்</string>
    <string name="settings_blocked_body">அவர்கள் உங்களுக்குச் செய்தி அனுப்பவோ உங்கள் கடைசிப் பார்வையைப் பார்க்கவோ முடியாது.</string>
    <string name="blocked_empty">நீங்கள் யாரையும் பிளாக் செய்யவில்லை.</string>
    <!-- Phase 1.4: security -->
    <string name="lock_title">Samvad பூட்டப்பட்டுள்ளது</string>
    <string name="lock_body">கைரேகை, முகம் அல்லது ஃபோன் திரைப் பூட்டால் திறக்கவும்.</string>
    <string name="lock_unlock">திற</string>
    <string name="lock_prompt_title">Samvad ஐத் திற</string>
    <string name="lock_prompt_subtitle">நீங்கள்தான் என உறுதிசெய்யவும்</string>
    <string name="settings_app_lock">ஆப் பூட்டு</string>
    <string name="settings_app_lock_body">Samvad ஐத் திறக்க கைரேகை, முகம் அல்லது திரைப் பூட்டைக் கேட்கும்.</string>
    <string name="settings_app_lock_unavailable">முதலில் ஃபோனில் திரைப் பூட்டை அமைக்கவும்.</string>
    <string name="settings_lock_after">தானாகப் பூட்டு</string>
    <string name="settings_lock_immediately">உடனடியாக</string>
    <string name="settings_lock_one_minute">1 நிமிடத்துக்குப் பிறகு</string>
    <string name="settings_lock_thirty_minutes">30 நிமிடங்களுக்குப் பிறகு</string>
    <string name="settings_block_screenshots">ஸ்கிரீன்ஷாட்டைத் தடு</string>
    <string name="settings_block_screenshots_body">Samvad இன் ஸ்கிரீன்ஷாட், திரைப் பதிவுகளைத் தடுத்து, சமீபத்திய ஆப்களில் மறைக்கும்.</string>
    <string name="settings_previews">செய்தி முன்னோட்டம் காட்டு</string>
    <string name="settings_previews_body">நோட்டிபிகேஷனில் யார் என்ன எழுதினார் எனக் காட்டும். பூட்டுத் திரையில் செய்தி உரை எப்போதும் காட்டப்படாது.</string>
    <!-- Phase 1.5: two-step verification -->
    <string name="two_step_title">இரு-படி சரிபார்ப்பு</string>
    <string name="two_step_verify_title">உங்கள் PIN ஐ உள்ளிடவும்</string>
    <string name="two_step_verify_body">%1$s இல் இரு-படி சரிபார்ப்பு இயக்கத்தில் உள்ளது. தொடர 6 இலக்க PIN ஐ உள்ளிடவும்.</string>
    <string name="two_step_pin_label">இரு-படி PIN</string>
    <string name="two_step_wrong">தவறான PIN.</string>
    <plurals name="two_step_attempts_left">
        <item quantity="one">தவறான PIN. சிறிது நேரம் பூட்டப்படும் முன் %1$d முயற்சி மீதம்.</item>
        <item quantity="other">தவறான PIN. சிறிது நேரம் பூட்டப்படும் முன் %1$d முயற்சிகள் மீதம்.</item>
    </plurals>
    <string name="two_step_locked">பல தவறான PIN கள். %1$s க்குப் பிறகு முயலவும்.</string>
    <string name="two_step_locked_plain">பல தவறான PIN கள். பிறகு முயலவும்.</string>
    <string name="two_step_network">சரிபார்க்க முடியவில்லை. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.</string>
    <string name="two_step_forgot_hint">PIN நினைவில்லையா?</string>
    <string name="two_step_forgot">PIN மறந்துவிட்டதா?</string>
    <string name="two_step_forgot_title">இரு-படி சரிபார்ப்பை மீட்டமைக்கவா?</string>
