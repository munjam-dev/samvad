    <!-- Setup required -->
    <string name="setup_required_title">Firebase அமைப்பு தேவை</string>
    <string name="setup_required_body">இந்த பில்டில் Firebase கட்டமைப்பு இல்லை. உங்கள் ப்ராஜெக்டுக்கான app/google-services.json ஐச் சேர்க்கவும், அல்லது -Psamvad.useEmulators=true உடன் டெபக் பதிப்பை உருவாக்கவும்.</string>

