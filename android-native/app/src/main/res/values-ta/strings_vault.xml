    <!-- Menu and add -->
    <string name="vault_add">வால்ட்டில் சேர்</string>
    <string name="vault_add_photo">போட்டோ</string>
    <string name="vault_add_photo_body">கேலரியிலிருந்து போட்டோவைத் தேர்ந்தெடுங்கள்</string>
    <string name="vault_add_document">ஆவணம்</string>
    <string name="vault_add_document_body">PDF அல்லது வேறு கோப்பைத் தேர்ந்தெடுங்கள்</string>
    <string name="vault_add_id">அடையாள நகல்</string>
    <string name="vault_add_id_body">அடையாள அட்டையின் போட்டோ அல்லது PDF</string>
    <string name="vault_add_note">குறிப்பு</string>
    <string name="vault_add_note_body">தனிப்பட்ட குறிப்பு எழுதுங்கள்</string>
    <string name="vault_lock_now">இப்போதே பூட்டு</string>
    <string name="vault_about">இந்த வால்ட் பற்றி</string>
    <string name="vault_about_body">பொருட்கள் இந்த போனிலேயே என்கிரிப்ட் செய்யப்படுகின்றன. அதற்கான கீ போனின் பாதுகாப்பான கீ ஸ்டோரில் வைக்கப்படுகிறது. வால்ட் பேக்கப்பை இயக்கும் வரை எதுவும் அப்லோடு ஆவதில்லை; இயக்கினால் என்கிரிப்ட் செய்யப்பட்ட நகல் உங்கள் சொந்த Google Drive-க்குச் செல்லும். வால்ட் Android-இன் சொந்த பேக்கப்களிலோ போனிலிருந்து போனுக்கு மாற்றுவதிலோ சேராது. வால்ட் பேக்கப் இல்லாமல் இந்த போனை இழந்தால், பொருட்களும் இழக்கப்படும்.</string>
    <string name="vault_protection_strongbox">கீ பாதுகாப்பு: பிரத்யேக பாதுகாப்புச் சிப்</string>
    <string name="vault_protection_hardware">கீ பாதுகாப்பு: பாதுகாப்பான ஹார்டுவேர்</string>
    <string name="vault_protection_software">கீ பாதுகாப்பு: சாஃப்ட்வேர் மட்டும். இந்த போனில் கீகளுக்கான பாதுகாப்பான ஹார்டுவேர் இல்லை.</string>
    <string name="vault_protection_unknown">கீ பாதுகாப்பு: இன்னும் சரிபார்க்கப்படவில்லை</string>
    <string name="vault_close">மூடு</string>

    <!-- Item actions -->
    <string name="vault_item_options">%1$s க்கான விருப்பங்கள்</string>
    <string name="vault_rename">பெயர் மாற்று</string>
    <string name="vault_rename_title">பொருளின் பெயரை மாற்று</string>
    <string name="vault_title_label">தலைப்பு</string>
    <string name="vault_delete">நீக்கு</string>
    <string name="vault_delete_title">இந்தப் பொருளை நீக்கவா?</string>
    <string name="vault_delete_body">\"%1$s\" வால்ட்டிலிருந்து நீக்கப்படும், திரும்பப் பெற முடியாது.</string>
    <string name="vault_export">நகலைச் சேமி</string>
    <string name="vault_export_title">வால்ட்டுக்கு வெளியே நகலைச் சேமிக்கவா?</string>
    <string name="vault_export_body">நகல் என்கிரிப்ட் செய்யப்படாது. நீங்கள் தேர்ந்தெடுக்கும் இடத்தைத் திறக்கக்கூடிய யாரும் அதைப் படிக்கலாம்.</string>
    <string name="vault_export_choose">சேமிக்கும் இடத்தைத் தேர்ந்தெடுங்கள்</string>
    <string name="vault_open_title">வேறு ஆப்பில் திறக்கவா?</string>
    <string name="vault_open_body">மற்ற ஆப்புக்காகப் படிக்கக்கூடிய தற்காலிக நகல் உருவாக்கப்படும். நீங்கள் திரும்பி வந்ததும் Samvad அதை நீக்கிவிடும், ஆனால் மற்ற ஆப் தனது நகலை வைத்திருக்கலாம்.</string>
    <string name="vault_open">திற</string>
    <string name="vault_open_failed">இந்த போனில் இந்தக் கோப்பைத் திறக்கும் ஆப் இல்லை. அதற்குப் பதிலாக நகலைச் சேமிக்கலாம்.</string>
    <string name="vault_open_unsupported">இந்த வகைக் கோப்பை வால்ட்டிலிருந்து திறக்க முடியாது. அதற்குப் பதிலாக நகலைச் சேமிக்கலாம்.</string>
    <string name="vault_image_failed">இந்தப் படத்தைக் காட்ட முடியவில்லை. அதற்குப் பதிலாக நகலைச் சேமிக்கலாம்.</string>
    <string name="vault_image_cd">%1$s, படம்</string>
    <string name="vault_missing">இந்தப் பொருள் இனி வால்ட்டில் இல்லை.</string>

