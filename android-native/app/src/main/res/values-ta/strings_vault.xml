<!-- Personal Vault (Phase 4). Local only: nothing here may promise cloud backup or end-to-end encryption of chats. -->
<resources>
    <string name="vault_title">தனிப்பட்ட வால்ட்</string>

    <!-- Gate -->
    <string name="vault_prompt_title">உங்கள் வால்ட்டைத் திறக்கவும்</string>
    <string name="vault_prompt_subtitle">நீங்கள்தான் என உறுதிசெய்யுங்கள்</string>
    <string name="vault_locked_title">உங்கள் வால்ட் பூட்டப்பட்டுள்ளது</string>
    <string name="vault_locked_body">உங்கள் ஆவணங்கள், போட்டோக்கள், குறிப்புகளைத் திறக்க கைரேகை, முகம் அல்லது ஸ்கிரீன் லாக் மூலம் நீங்கள்தான் என உறுதிசெய்யுங்கள்.</string>
    <string name="vault_unlock">வால்ட்டைத் திற</string>
    <string name="vault_no_screen_lock_title">முதலில் ஸ்கிரீன் லாக் அமையுங்கள்</string>
    <string name="vault_no_screen_lock_body">கைரேகை, முகம் அல்லது ஸ்கிரீன் லாக் மூலம் மட்டுமே வால்ட் திறக்கும். உங்கள் போனின் அமைப்புகளில் ஒன்றைச் சேர்த்துவிட்டு மீண்டும் வாருங்கள்.</string>
    <string name="vault_key_lost_title">வால்ட்டைத் திறக்க முடியவில்லை</string>
    <string name="vault_key_lost_body">வால்ட்டுக்கான இந்த போனின் பாதுகாப்பு கீ இல்லாமல் போய்விட்டது. ஃபேக்டரி ரீசெட் அல்லது போனின் பாதுகாப்பு மாற்றத்துக்குப் பிறகு இப்படி நடக்கலாம். சேமித்த பொருட்களை இனி படிக்க முடியாது. வால்ட்டை அழித்துவிட்டு புதிதாகத் தொடங்கலாம்.</string>
    <string name="vault_erase">வால்ட்டை அழி</string>
    <string name="vault_erase_title">முழு வால்ட்டையும் அழிக்கவா?</string>
    <string name="vault_erase_body">வால்ட்டில் உள்ள அனைத்தும் இந்த போனிலிருந்து நீக்கப்படும். இதைத் திரும்பப் பெற முடியாது.</string>
    <string name="vault_erase_confirm">அனைத்தையும் அழி</string>
    <string name="vault_opening">வால்ட் திறக்கிறது</string>

