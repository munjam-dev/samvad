<resources>
    <string name="vault_title">निजी वॉल्ट</string>

    <!-- Gate -->
    <string name="vault_prompt_title">अपना वॉल्ट खोलें</string>
    <string name="vault_prompt_subtitle">पुष्टि करें कि यह आप हैं</string>
    <string name="vault_locked_title">आपका वॉल्ट लॉक है</string>
    <string name="vault_locked_body">अपने दस्तावेज़, फ़ोटो और नोट खोलने के लिए फ़िंगरप्रिंट, चेहरे या स्क्रीन लॉक से पुष्टि करें कि यह आप हैं।</string>
    <string name="vault_unlock">वॉल्ट खोलें</string>
    <string name="vault_no_screen_lock_title">पहले स्क्रीन लॉक सेट करें</string>
    <string name="vault_no_screen_lock_body">वॉल्ट केवल आपके फ़िंगरप्रिंट, चेहरे या स्क्रीन लॉक से खुलता है। अपने फ़ोन की सेटिंग में इनमें से कोई एक जोड़ें, फिर वापस आएँ।</string>
    <string name="vault_key_lost_title">वॉल्ट खोला नहीं जा सकता</string>
    <string name="vault_key_lost_body">वॉल्ट के लिए इस फ़ोन की सुरक्षित कुंजी अब मौजूद नहीं है। फ़ैक्टरी रीसेट या फ़ोन की सुरक्षा में बदलाव के बाद ऐसा हो सकता है। सहेजी गई चीज़ें अब पढ़ी नहीं जा सकतीं। आप वॉल्ट मिटाकर नए सिरे से शुरू कर सकते हैं।</string>
    <string name="vault_erase">वॉल्ट मिटाएँ</string>
    <string name="vault_erase_title">पूरा वॉल्ट मिटाएँ?</string>
    <string name="vault_erase_body">वॉल्ट की हर चीज़ इस फ़ोन से हट जाएगी। इसे वापस नहीं किया जा सकता।</string>
    <string name="vault_erase_confirm">सब कुछ मिटाएँ</string>
    <string name="vault_opening">वॉल्ट खुल रहा है</string>

