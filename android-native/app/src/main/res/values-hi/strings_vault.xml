    <string name="vault_about">इस वॉल्ट के बारे में</string>
    <string name="vault_about_body">चीज़ें इस फ़ोन पर एक कुंजी से एन्क्रिप्ट होती हैं, जो फ़ोन के सुरक्षित कुंजी-भंडार में रहती है। कुछ भी अपलोड नहीं होता, और वॉल्ट बैकअप या फ़ोन-से-फ़ोन ट्रांसफ़र में शामिल नहीं है। फ़ोन खो जाने पर ये चीज़ें भी खो जाएँगी।</string>
    <string name="vault_protection_strongbox">कुंजी की सुरक्षा: समर्पित सुरक्षा चिप</string>
    <string name="vault_protection_hardware">कुंजी की सुरक्षा: सुरक्षित हार्डवेयर</string>
    <string name="vault_protection_software">कुंजी की सुरक्षा: केवल सॉफ़्टवेयर। इस फ़ोन में कुंजियों के लिए सुरक्षित हार्डवेयर नहीं है।</string>
    <string name="vault_protection_unknown">कुंजी की सुरक्षा: अभी जाँची नहीं गई</string>
