<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Moments, second pass: report from the viewer, capture note, audience line, photo text and pen, viewer navigation -->

    <!-- Viewer: report -->
    <string name="moment_report">ఈ మోమెంట్‌ను రిపోర్ట్ చేయండి</string>
    <string name="moment_report_body">మీరు ఎంచుకున్న కారణంతో పాటు, ఈ వ్యక్తి నుంచి చివరి 5 సందేశాలు సమీక్ష కోసం Samvadకు పంపబడతాయి. మోమెంట్ జత చేయబడదు. వారికి తెలియజేయబడదు.</string>
    <string name="moment_report_no_chat">ఈ వ్యక్తితో చాట్ కనపడలేదు, అందుకే రిపోర్ట్ పంపబడలేదు. చాట్ నుంచి వారిని రిపోర్ట్ చేయవచ్చు.</string>

    <!-- Viewer: moving around -->
    <string name="moment_position">మోమెంట్ %1$d / %2$d</string>
    <string name="moment_next">తర్వాతి మోమెంట్</string>
    <string name="moment_previous">మునుపటి మోమెంట్</string>

    <!-- Composer: note and audience -->
    <string name="moment_capture_note">మోమెంట్ చూడగలిగినవారు స్క్రీన్‌షాట్ తీయవచ్చు లేదా సేవ్ చేసుకోవచ్చు.</string>
    <string name="moment_audience_line">ఎవరు చూడగలరు: %1$s</string>
    <string name="moment_audience_pick_hint">షేర్ చేయడానికి కనీసం ఒకరిని ఎంచుకోండి.</string>

