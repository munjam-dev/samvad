<?xml version="1.0" encoding="utf-8"?>
<!-- Only private cache folders are shareable: received documents (to open them in another app) and
     chat exports (to share or save them, for example to Google Drive). -->
<paths>
    <cache-path name="media" path="media/" />
    <cache-path name="exports" path="exports/" />
    <!-- Personal Vault: one-time decrypted copies, deleted when viewing ends. -->
    <cache-path name="vault_view" path="vault_view/" />
</paths>
