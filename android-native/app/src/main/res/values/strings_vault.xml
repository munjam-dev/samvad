    <string name="vault_added">Added to the vault</string>
    <string name="vault_exported">Copy saved</string>
    <string name="vault_deleted">Deleted</string>
    <string name="vault_note_saved">Note saved</string>
    <string name="vault_error_locked">The vault locked. Unlock it and try again.</string>
    <string name="vault_error_too_large">That is too large. The limit is 100 MB for a file and 100,000 characters for a note.</string>
    <string name="vault_error_empty">That file is empty.</string>
    <string name="vault_error_unreadable">Couldn\'t read that. It may have been changed or damaged.</string>
    <string name="vault_error_failed">That didn\'t work. Please try again.</string>
