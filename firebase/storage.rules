rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Phase 1.5: same session check as firestore.rules verifiedSession().
    function signedIn() {
      let t = request.auth.token;
      return request.auth != null
        && ((t.firebase.sign_in_provider == 'phone' && t.get('ts', false) != true)
            || (t.firebase.sign_in_provider == 'custom'
                && t.get('pv', null) is string
                && (t.get('ts', false) != true || t.get('pv', null) == t.get('tsv', null))));
    }

    // Cross-service rule: membership comes from the Firestore conversation document.
    function isMember(cid) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(cid)).data.members;
    }

    // Phase 6: announcement mode. While a group's onlyAdminsSend is true, only admins upload message files.
    function mayPost(cid) {
      let c = firestore.get(/databases/(default)/documents/conversations/$(cid)).data;
      return c.type != 'group' || c.get('onlyAdminsSend', false) != true || request.auth.uid in c.admins;
    }

    // Allow-list of content types. Executables (APK, scripts, binaries) are never accepted.
    function allowedType(type) {
      return type.matches('image/(jpeg|png|webp)')
        || type.matches('audio/(mp4|aac|mpeg|ogg)')
        || type == 'video/mp4'
        || type.matches('application/pdf')
        || type.matches('text/plain')
        || type.matches('application/zip')
        || type.matches('application/msword')
        || type.matches('application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation)')
        || type.matches('application/vnd[.]ms-(excel|powerpoint)');
    }

    // avatars/{uid}/{uuid}.jpg: written only by the setProfilePhoto function (which strips metadata).
    // Hidden from people the owner has blocked, and from everyone but the owner's chat partners (or nobody)
    // when the owner's "Profile photo" setting says so (users/{uid}/settings/privacy.photoVisibility).
    // "Chat partner" means a direct chat the owner started or has sent a message in (engagedBy). The files are
    // never listable, and their names are random, so a name is learned only through profiles/{uid}/private/photo.
    match /avatars/{uid}/{file} {
      function privacySettings() {
        return firestore.get(/databases/(default)/documents/users/$(uid)/settings/privacy).data;
      }
      function isChatPartner() {
        let a = request.auth.uid;
        let conv = /databases/(default)/documents/conversations/$(a < uid ? a + '_' + uid : uid + '_' + a);
        return firestore.exists(conv) && uid in firestore.get(conv).data.get('engagedBy', []);
      }
      function photoShown() {
        return !firestore.exists(/databases/(default)/documents/users/$(uid)/settings/privacy)
          || privacySettings().get('photoVisibility', 'everyone') == 'everyone'
          || (privacySettings().get('photoVisibility', 'everyone') == 'partners' && isChatPartner());
      }
      allow get: if signedIn()
        && (request.auth.uid == uid
            || (!firestore.exists(/databases/(default)/documents/users/$(uid)/blocked/$(request.auth.uid))
                && photoShown()));
      allow list: if false;
      allow write: if false;
    }

    // groupPhotos/{cid}/{uuid}.jpg: written only by the setGroupPhoto function; members can see it.
    match /groupPhotos/{cid}/{file} {
      allow read: if isMember(cid);
      allow write: if false;
    }

    // communityPhotos/{id}/{uuid}.jpg: written only by the setCommunityPhoto function; community members can see it.
    match /communityPhotos/{id}/{file} {
      allow read: if signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/communities/$(id)).data.members;
      allow write: if false;
    }

    // Announcements conversations accept files from community admins only.
    function mayUpload(cid) {
      let c = firestore.get(/databases/(default)/documents/conversations/$(cid)).data;
      return c.type != 'community_announcements' || request.auth.uid in c.admins;
    }

    function isE2ee(cid) {
      return firestore.get(/databases/(default)/documents/conversations/$(cid)).data.get('e2ee', false) == true;
    }

    // conversations/{cid}/{messageId}/{file}: uploaded once by a member before the message doc is written.
    match /conversations/{cid}/{mid}/{file} {
      allow read: if isMember(cid);

      allow create: if isMember(cid)
        && mayPost(cid)
        && mayUpload(cid)
        && resource == null
        && mid.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && file.matches('^[A-Za-z0-9._-]{1,100}$')
        && request.resource.size > 0
        && (isE2ee(cid)
            // End-to-end encrypted chat: only ciphertext, as blob.bin or thumb.bin (the real name and type are in the
            // encrypted message). Plaintext media types are refused there. 28 bytes of IV and tag on top of 16 MB.
            ? (request.resource.contentType == 'application/octet-stream'
                && file.matches('^(blob|thumb)[.]bin$')
                && request.resource.size <= 16 * 1024 * 1024 + 64)
            : (request.resource.size <= 16 * 1024 * 1024
                && allowedType(request.resource.contentType)
                // Chat video: video/mp4 only as video.mp4 (and video.mp4 only as video/mp4); its poster frame is a small JPEG.
                && ((request.resource.contentType == 'video/mp4') == (file == 'video.mp4'))
                && (file != 'thumb.jpg' || (request.resource.contentType == 'image/jpeg' && request.resource.size <= 256 * 1024))))
        && request.resource.metadata.senderId == request.auth.uid
        && !firestore.exists(/databases/(default)/documents/conversations/$(cid)/messages/$(mid));

      // Files are immutable; deletion is done by trusted code when a message is deleted.
      allow update, delete: if false;
    }

    // statuses/{author}/{sid}/(photo.jpg|video.mp4|voice.m4a): written once by the author. Readable by the author, and by anyone the
    // status document says may see it (checked against the Firestore document, including blocks).
    match /statuses/{author}/{sid}/{file} {
      function item() {
        return firestore.get(/databases/(default)/documents/statuses/$(author)/items/$(sid)).data;
      }
      allow read: if signedIn()
        && (request.auth.uid == author
            || (firestore.exists(/databases/(default)/documents/statuses/$(author)/items/$(sid))
                && request.auth.uid in item().get('visibleTo', [])
                && request.time < item().get('expiresAt', timestamp.date(1970, 1, 1))
                && !firestore.exists(/databases/(default)/documents/users/$(author)/blocked/$(request.auth.uid))
                && !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/blocked/$(author))));

      allow create: if signedIn()
        && request.auth.uid == author
        && resource == null
        && sid.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.size > 0
        && (
          (file == 'photo.jpg' && request.resource.size <= 8 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)'))
          || (file == 'video.mp4' && request.resource.size <= 16 * 1024 * 1024
            && request.resource.contentType == 'video/mp4')
          || (file == 'voice.m4a' && request.resource.size <= 4 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mp4|aac)'))
        )
        && !firestore.exists(/databases/(default)/documents/statuses/$(author)/items/$(sid));

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
